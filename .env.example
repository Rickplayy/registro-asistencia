# ============================================================================
# MODO LOCAL — no se necesita NINGUNA variable para arrancar:
#   npm install && npm run dev
# La base de datos es SQLite (data/registro-asistencia.db) y la ENCRYPTION_KEY
# se genera sola en data/encryption.key la primera vez.
#
# Si prefieres controlar los valores, copia este archivo a .env.local.
# .env.local está en .gitignore: NUNCA subas credenciales al repo.
# ============================================================================

# --- Cifrado de campos sensibles (CURP, RFC, fecha de nacimiento) y firma ---
# --- de sesiones/PIN. 32 bytes en base64. Generar con: npm run generate:key ---
# Si se omite, se genera y persiste automáticamente en data/encryption.key.
#ENCRYPTION_KEY=

# --- Rutas del modo local (opcionales) ---
# Archivo de la base SQLite (":memory:" para efímera):
#LOCAL_DB_PATH=./data/registro-asistencia.db
# Carpeta para datos locales (base + llave generada):
#LOCAL_DATA_DIR=./data
