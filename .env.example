# ============================================================================
# Copia este archivo a .env.local y llena los valores reales.
# .env.local está en .gitignore: NUNCA subas credenciales al repo.
# En producción, estos valores viven en el gestor de secretos del hosting
# (Vercel → Environment Variables; llaves de cifrado → Supabase Vault/KMS).
# ============================================================================

# --- Supabase (Dashboard → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo backend. Salta RLS: jamás exponerla al cliente ni prefijarla con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cifrado de campos sensibles (CURP, RFC, fecha de nacimiento) ---
# 32 bytes en base64. Generar con: npm run generate:key
ENCRYPTION_KEY=
